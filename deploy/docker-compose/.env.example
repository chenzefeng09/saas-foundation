# =============================================================================
# saas-foundation 本地开发栈环境变量
# 复制为 .env 并按需调整。.env 已被 .gitignore 排除。
# =============================================================================

# Postgres
POSTGRES_VERSION=pg16
POSTGRES_DB=foundation
POSTGRES_SUPER_PASSWORD=postgres_super_change_me
APP_USER_PASSWORD=app_user_change_me
APP_ADMIN_PASSWORD=app_admin_change_me
APP_MIGRATOR_PASSWORD=app_migrator_change_me
APP_OBSERVABILITY_PASSWORD=app_obs_change_me

# PgBouncer
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Keycloak
KEYCLOAK_VERSION=25.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_change_me
KEYCLOAK_DB_PASSWORD=keycloak_db_change_me
KEYCLOAK_HOSTNAME=localhost

# Redis
REDIS_VERSION=7-alpine
REDIS_PASSWORD=redis_change_me

# ClickHouse
CLICKHOUSE_VERSION=24.8
CLICKHOUSE_USER=foundation
CLICKHOUSE_PASSWORD=clickhouse_change_me

# OpenSearch
OPENSEARCH_VERSION=2.16.0
OPENSEARCH_INITIAL_ADMIN_PASSWORD=OpenSearch_Change_Me_123!

# Vault
VAULT_VERSION=1.17
VAULT_DEV_ROOT_TOKEN=dev-root-token-change-me

# OTel Collector
OTEL_COLLECTOR_VERSION=0.108.0

# MinIO (S3 兼容)
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=foundation
MINIO_ROOT_PASSWORD=minio_change_me_min_12_chars

# Unleash (Feature Flag)
UNLEASH_VERSION=6.4
UNLEASH_DB_PASSWORD=unleash_db_change_me
# dev 环境 insecure token（与 dev.yml INIT_*_API_TOKENS 对齐）
FEATURE_FLAG_UNLEASH_ADMIN_TOKEN=*:*.unleash-insecure-admin-api-token
FEATURE_FLAG_UNLEASH_FRONTEND_TOKEN=*:development.unleash-insecure-frontend-api-token

# Mailhog (本地邮件)
MAILHOG_VERSION=v1.0.1

# 端口分配（避免与本机冲突时调整）
PORT_POSTGRES=5432
PORT_PGBOUNCER=6432
PORT_REDIS=6379
PORT_KEYCLOAK=8080
PORT_CLICKHOUSE_HTTP=8123
PORT_CLICKHOUSE_TCP=9000
PORT_OPENSEARCH_HTTP=9200
PORT_OPENSEARCH_DASH=5601
PORT_VAULT=8200
PORT_MINIO_API=9001
PORT_MINIO_CONSOLE=9002
PORT_OTEL_GRPC=4317
PORT_OTEL_HTTP=4318
PORT_UNLEASH=4242
PORT_FEATURE_FLAG=8014
PORT_SEARCH=8009
PORT_MAILHOG_UI=8025
PORT_MAILHOG_SMTP=1025
PORT_JAEGER_UI=16686
# 容器内端口固定，host 端口避开 agent-platform 栈(8005-8013)与 foundation 已有口
PORT_NOTIFICATION=18008
PORT_API_PLATFORM=18010
PORT_PAM=18015
PORT_DLP=18007
PORT_COMPLIANCE=18014
PORT_SECURITY_OPS=18019
PORT_LIFECYCLE=18006
PORT_DATA_PROTECTION=18016
